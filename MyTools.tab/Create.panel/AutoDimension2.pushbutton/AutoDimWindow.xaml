<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoDimension 2"
        Width="340" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize">
    <StackPanel Margin="14">
        <TextBlock x:Name="status" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Guide lines placed. Move or copy any of them &#x2014; including the interior lines you just clicked &#x2014; then click Create Dimensions."/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Create Dimensions" Click="create_click"
                    Margin="0,0,8,0" Padding="10,5" IsDefault="True"/>
            <Button Content="Cancel" Click="cancel_click" Padding="10,5"/>
        </StackPanel>
    </StackPanel>
</Window>
